# Copy this file to .env in this directory. Never commit the real .env.
# Place your GGUF model in ./models/ (or set WAKE_MODELS_DIR).
WAKE_MODEL_FILE=your-model-file.gguf
WAKE_MODELS_DIR=./models

# Generate a unique random key; use the same value as WAKE_API_KEY in Vercel.
WAKE_RUNTIME_API_KEY=replace-with-a-long-random-secret

# Keep the port bound to loopback unless protected by a TLS reverse proxy.
WAKE_BIND_ADDRESS=127.0.0.1
WAKE_RUNTIME_PORT=8080

# Conservative starting settings; tune only after checking host RAM/VRAM.
WAKE_CTX_SIZE=4096
WAKE_PARALLEL=1
WAKE_GPU_LAYERS=0
