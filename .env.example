# Server-side OpenAI-compatible model endpoint.
# On Vercel, use a reachable remote endpoint; 127.0.0.1 points to the Vercel instance.
WAKE_BASE_URL=http://127.0.0.1:8080/v1
WAKE_MODEL=local-model
WAKE_API_KEY=
WAKE_SYSTEM_PROMPT=
WAKE_REQUEST_TIMEOUT_MS=120000

# Required before deployment. Use a long, unique password and a random secret of 32+ characters.
WAKE_ACCESS_PASSWORD=
WAKE_SESSION_SECRET=
