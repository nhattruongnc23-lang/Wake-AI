# Google OAuth credentials from Google Cloud Console
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Auth.js session signing secret (generate a unique 32+ character value)
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Only verified Google accounts in this comma-separated list may sign in.
WAKE_ALLOWED_EMAILS=
# One allowlisted email receives OWNER role when its account is first created.
WAKE_OWNER_EMAIL=

# PostgreSQL pooled connection for the Vercel runtime
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler:5432/neondb?sslmode=require

# Direct PostgreSQL connection for Prisma schema migrations
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/neondb?sslmode=require

# Dedicated Koro -> Wake Moderation service credential. Never expose to browser code.
KORO_API_SECRET=

# Dedicated analyzer -> Wake result-ingestion credential (32+ random characters).
# Keep separate from KORO_API_SECRET; server-side only.
WAKE_ANALYZER_SECRET=

# Future isolated inference worker configuration; not active in v0.1.
WAKE_CLASSIFIER_URL=
WAKE_CLASSIFIER_API_KEY=
