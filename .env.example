# Server-side OpenAI-compatible model endpoint.
# Use a reachable remote endpoint when deploying; 127.0.0.1 refers to the server itself.
WAKE_BASE_URL=http://127.0.0.1:8080/v1
WAKE_MODEL=local-model
WAKE_API_KEY=
WAKE_SYSTEM_PROMPT=
WAKE_REQUEST_TIMEOUT_MS=120000

# Do not expose this prototype publicly until authentication and rate limiting are added.
