# Google OAuth credentials from Google Cloud Console
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Auth.js session signing secret (generate a unique 32+ character value)
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Comma-separated email allowlist. Only these verified Google accounts may sign in.
WAKE_ALLOWED_EMAILS=

# PostgreSQL connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/wake_moderation?sslmode=require

# Dedicated Koro -> Wake Moderation service credential. Never expose to browser code.
KORO_API_SECRET=

# Optional model gateway values retained for future classifier integration.
WAKE_BASE_URL=
WAKE_MODEL=
WAKE_API_KEY=
WAKE_REQUEST_TIMEOUT_MS=120000
